---
import "../global.css";

const title = "PrivDark — Your Private AI Studio";
const description = "Estudio audiovisual con IA. Anima imágenes y crea clips de vídeo de 10 segundos con Wan 2.2.";
const baseUrl = import.meta.env.BASE_URL;
const siteOrigin = Astro.site?.origin ?? "https://privdark.pages.dev";
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteOg = new URL(`${baseUrl}og.png`, siteOrigin).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "PrivDark",
  url: canonical,
  description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any (web)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08070d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="keywords" content="PrivDark, IA, generación de vídeo, imagen a vídeo, Wan 2.2" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${baseUrl}og.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PrivDark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={baseUrl} class="brand-lockup" aria-label="PrivDark, inicio">
          <svg viewBox="0 0 40 40" class="brand-mark" aria-hidden="true">
            <defs>
              <linearGradient id="privdark-mark" x1="4" y1="4" x2="36" y2="36" gradientUnits="userSpaceOnUse">
                <stop stop-color="#e7c5ff" /><stop offset="0.52" stop-color="#a76bff" /><stop offset="1" stop-color="#ed70d7" />
              </linearGradient>
            </defs>
            <path d="M20 3.5 34 11.5v17L20 36.5 6 28.5v-17L20 3.5Z" fill="none" stroke="url(#privdark-mark)" stroke-width="1.7" />
            <path d="M24.8 10.7a10.1 10.1 0 1 0 4.5 18.6A11.2 11.2 0 0 1 24.8 10.7Z" fill="url(#privdark-mark)" />
            <circle cx="25.9" cy="19.5" r="1.35" fill="#100b18" />
          </svg>
          <span class="brand-wordmark">PRIV<span>DARK</span></span>
          <span class="brand-pill">AI STUDIO</span>
        </a>
        <div class="header-status">
          <span class="status-indicator" aria-hidden="true"></span>
          <span>Estudio creativo</span>
        </div>
      </div>
    </header>

    <main>
      <section class="wrap hero">
        <p class="eyebrow"><span class="eyebrow-line"></span> IMAGE TO VIDEO <span class="eyebrow-line"></span></p>
        <h1>Convierte imágenes en <span class="gradient-text">movimiento.</span></h1>
        <p class="hero-lead">
          Crea clips cinematográficos con IA a partir de una imagen y una descripción de movimiento.
          Tu pequeño estudio audiovisual, impulsado por Wan 2.2.
        </p>
        <div class="chips">
          <span class="feature-chip"><span class="chip-dot"></span> Wan 2.2</span>
          <span class="feature-chip">10 segundos por clip</span>
          <span class="feature-chip">Exportación MP4</span>
        </div>
      </section>

      <section class="wrap studio" id="studio">
        <div class="studio-shell">
          <div class="studio-card stack">
            <div class="section-heading">
              <div class="section-number">01</div>
              <div><h2>Imagen de origen</h2><p>Elige la imagen que quieres animar.</p></div>
            </div>

            <label class="dropzone" data-dropzone>
              <input type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" data-file-input />
              <div class="dropzone-empty" data-dropzone-empty>
                <div class="upload-icon-wrap">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15.5v3A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5v-3" />
                  </svg>
                </div>
                <p class="title">Arrastra una imagen aquí</p>
                <p class="browse">o explora tus archivos</p>
                <p class="hint">PNG, JPG o WEBP · máximo 8 MB</p>
                <p class="note">Usa imágenes de personajes adultos ficticios.</p>
              </div>
              <img data-dropzone-preview class="preview-img" alt="Vista previa" />
            </label>

            <div>
              <div class="section-heading compact">
                <div class="section-number">02</div>
                <div><h2>Dirección creativa</h2><p>Describe qué debe ocurrir en el vídeo.</p></div>
              </div>
              <textarea rows="5" data-prompt class="prompt-field" placeholder="Describe el movimiento, la expresión, la cámara, la iluminación y el ambiente de la escena..."></textarea>
              <div class="prompt-meta">
                <span>Especifica acciones y movimientos. El modelo ya analiza la imagen.</span>
                <span data-prompt-count>0 / 1200</span>
              </div>
            </div>

            <details class="advanced-panel">
              <summary><span>Parámetros de generación</span><span class="advanced-summary-meta">Configuración optimizada</span></summary>
              <div class="advanced-content">
                <div class="parameter-row">
                  <div>
                    <p class="parameter-label">Duración</p>
                    <p class="parameter-help">Duración máxima admitida por este Space</p>
                  </div>
                  <span class="parameter-value">10,0 s</span>
                </div>
                <div>
                  <div class="parameter-row">
                    <div>
                      <p class="parameter-label">Pasos de inferencia</p>
                      <p class="parameter-help">Más pasos pueden mejorar el detalle, pero consumen más GPU.</p>
                    </div>
                    <span class="parameter-value"><span data-steps-value>3</span></span>
                  </div>
                  <input type="range" min="3" max="4" step="1" value="3" data-steps class="steps-range" aria-label="Pasos" />
                </div>
                <p class="help-text">3 pasos priorizan la cuota gratuita. Puedes subir a 4 si prefieres más detalle.</p>
                <p class="help-text">La generación depende de Hugging Face ZeroGPU. Un clip de 10 s puede consumir casi toda la cuota diaria.</p>
              </div>
            </details>

            <div class="actions">
              <button data-generate class="btn-primary" disabled>
                <span class="pulse-dot" data-spinner></span>
                <span data-button-label>Generar vídeo</span>
                <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m7 4 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <p class="status-msg" data-status>Añade una imagen y describe el movimiento.</p>
            </div>
          </div>

          <div class="studio-card">
            <div class="output-head">
              <div class="section-heading">
                <div class="section-number">03</div>
                <div><h2>Resultado</h2><p>Tu creación aparecerá aquí.</p></div>
              </div>
              <span class="output-tag">PREVIEW</span>
            </div>

            <div class="result-frame">
              <div data-result-empty class="result-empty">
                <div class="result-empty-mark">
                  <svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.15" aria-hidden="true">
                    <rect x="5.5" y="9" width="37" height="30" rx="6" />
                    <path d="m21 17 11 7-11 7V17Z" fill="currentColor" stroke="none" />
                  </svg>
                </div>
                <p class="title">Tu vídeo está por crear</p>
                <p class="sub">La previsualización aparecerá en este espacio.</p>
              </div>
              <div data-result-loading class="result-loading hide">
                <div class="loading-orbit"><span></span><span></span><span></span></div>
                <p class="msg" data-loading-message>Preparando la generación...</p>
                <p class="sub">La GPU puede tardar un poco en estar disponible.</p>
              </div>
              <video data-result-video controls playsinline class="result-video hide" preload="metadata"></video>
            </div>

            <div class="output-foot">
              <p>Formato de salida: MP4 · 16 FPS nativos</p>
              <a data-download class="btn-ghost" download>
                <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M10 2.5v10m0 0 3.5-3.5M10 12.5 6.5 9M3.5 14v2A1.5 1.5 0 0 0 5 17.5h10a1.5 1.5 0 0 0 1.5-1.5v-2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Descargar MP4
              </a>
            </div>

            <div data-history-wrap class="history-wrap">
              <div class="history-heading"><span>Generaciones de esta sesión</span><span class="history-session-dot"></span></div>
              <ul data-history class="history-list"></ul>
            </div>
          </div>
        </div>
        <p class="studio-footnote">PRIVDARK <span>·</span> Estudio experimental de generación audiovisual con IA.</p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span class="footer-brand">PRIVDARK <em>·</em> YOUR PRIVATE AI STUDIO</span>
        <span>Experimentación audiovisual impulsada por Wan 2.2.</span>
      </div>
    </footer>

    <script>
      type Tone = "info" | "error" | "success";
      type ResultState = "empty" | "loading" | "ready";

      const W = import.meta.env.PUBLIC_WORKER_URL as string | undefined;
      if (!W) throw new Error("PUBLIC_WORKER_URL no definida");
      const MAX = 8 << 20;
      const PL = 1200;
      const HF = "https://cbensimon-wan2-2-fp8da-aoti-preview2.hf.space";

      const q = <T extends Element>(s: string): T => {
        const el = document.querySelector<T>(s);
        if (!el) throw new Error(`Falta: ${s}`);
        return el;
      };

      const dz = q<HTMLLabelElement>("[data-dropzone]");
      const fi = q<HTMLInputElement>("[data-file-input]");
      const de = q<HTMLElement>("[data-dropzone-empty]");
      const dp = q<HTMLImageElement>("[data-dropzone-preview]");
      const pr = q<HTMLTextAreaElement>("[data-prompt]");
      const pc = q<HTMLElement>("[data-prompt-count]");
      const st = q<HTMLInputElement>("[data-steps]");
      const sv = q<HTMLElement>("[data-steps-value]");
      const btn = q<HTMLButtonElement>("[data-generate]");
      const bl = q<HTMLElement>("[data-button-label]");
      const sp = q<HTMLElement>("[data-spinner]");
      const stt = q<HTMLElement>("[data-status]");
      const re = q<HTMLElement>("[data-result-empty]");
      const rl = q<HTMLElement>("[data-result-loading]");
      const lm = q<HTMLElement>("[data-loading-message]");
      const vid = q<HTMLVideoElement>("[data-result-video]");
      const dl = q<HTMLAnchorElement>("[data-download]");
      const hw = q<HTMLElement>("[data-history-wrap]");
      const hl = q<HTMLUListElement>("[data-history]");

      let file: File | null = null;
      let busy = false;
      let prev: string | null = null;

      const status = (m: string, t: Tone = "info"): void => {
        stt.textContent = m;
        stt.className = "status-msg" + (t === "error" ? " error" : t === "success" ? " success" : "");
      };

      const ready = (): void => {
        btn.disabled = !(file && pr.value.trim() && !busy);
      };

      const show = (s: ResultState): void => {
        re.classList.toggle("hide", s !== "empty");
        rl.classList.toggle("hide", s !== "loading");
        vid.classList.toggle("hide", s !== "ready");
        dl.classList.toggle("show", s === "ready");
      };

      const accept = (f: File): void => {
        const ok = /image\/(png|jpeg|webp)/i.test(f.type) || /\.(png|jpe?g|webp)$/i.test(f.name);
        if (!ok) return status("Formato no compatible. Usa PNG, JPG o WEBP.", "error");
        if (!f.size || f.size > MAX) return status(f.size ? "La imagen supera 8 MB." : "Archivo vacío.", "error");
        file = f;
        if (prev) URL.revokeObjectURL(prev);
        prev = URL.createObjectURL(f);
        dp.src = prev;
        dp.classList.add("show");
        de.classList.add("hide");
        ready();
        status("Imagen preparada. Ya puedes generar.", "success");
      };

      fi.onchange = () => {
        const f = fi.files?.[0];
        if (f) accept(f);
      };
      (["dragenter", "dragover"] as const).forEach((e) =>
        dz.addEventListener(e, (ev) => {
          ev.preventDefault();
          dz.dataset.active = "true";
        }),
      );
      (["dragleave", "drop"] as const).forEach((e) =>
        dz.addEventListener(e, () => {
          dz.dataset.active = "false";
        }),
      );
      dz.ondrop = (e) => {
        e.preventDefault();
        const f = e.dataTransfer?.files?.[0];
        if (f) accept(f);
      };
      window.addEventListener("paste", (e: ClipboardEvent) => {
        const f = e.clipboardData?.files?.[0];
        if (f) accept(f);
      });
      pr.maxLength = PL;
      pr.oninput = () => {
        pc.textContent = `${pr.value.length} / ${PL}`;
        ready();
      };
      st.oninput = () => {
        sv.textContent = st.value;
      };

      const videoUrl = (d: unknown): string | null => {
        if (typeof d === "string")
          return /^https?:/i.test(d) ? d : new URL(`/gradio_api/file=${d.replace(/^\//, "")}`, HF).href;
        if (!d || typeof d !== "object") return null;
        const rec = d as { url?: unknown; path?: unknown };
        const c = typeof rec.url === "string" ? rec.url : rec.path;
        if (typeof c !== "string" || !c) return null;
        return /^https?:/i.test(c) ? c : new URL(`/gradio_api/file=${c.replace(/^\//, "")}`, HF).href;
      };

      const parseEvt = (raw: string): string | null => {
        let ev = "message";
        const lines: string[] = [];
        for (const l of raw.split(/\r?\n/)) {
          if (l.startsWith("event:")) ev = l.slice(6).trim();
          else if (l.startsWith("data:")) lines.push(l.slice(5).trimStart());
        }
        if (!lines.length) return null;
        const data = lines.join("\n");
        if (ev === "error") {
          try {
            const p: unknown = JSON.parse(data);
            const msg =
              typeof p === "string"
                ? p
                : p && typeof p === "object" && "message" in p && typeof (p as { message: unknown }).message === "string"
                  ? (p as { message: string }).message
                  : data;
            throw new Error(msg);
          } catch (e) {
            if (e instanceof Error && e.message !== data) throw e;
            throw new Error(data || "Error de Hugging Face");
          }
        }
        if (ev !== "complete") return null;
        const p: unknown = JSON.parse(data);
        const u = videoUrl(Array.isArray(p) ? p[0] : null);
        if (!u) throw new Error("No se recibió el vídeo");
        return u;
      };

      const readSSE = async (body: ReadableStream<Uint8Array>): Promise<string> => {
        const r = body.getReader();
        const d = new TextDecoder();
        let buf = "";
        try {
          while (true) {
            const { value, done } = await r.read();
            if (done) break;
            buf += d.decode(value, { stream: true });
            const parts = buf.split(/\r?\n\r?\n/);
            buf = parts.pop() || "";
            for (const c of parts) {
              const u = parseEvt(c);
              if (u) return u;
            }
          }
          buf += d.decode();
          if (buf.trim()) {
            const u = parseEvt(buf);
            if (u) return u;
          }
        } finally {
          await r.cancel().catch(() => undefined);
          r.releaseLock();
        }
        throw new Error("Conexión cerrada sin vídeo");
      };

      const errMsg = async (res: Response): Promise<string> => {
        try {
          const j: unknown = await res.clone().json();
          if (j && typeof j === "object" && "error" in j && typeof (j as { error: unknown }).error === "string")
            return (j as { error: string }).error;
        } catch {
          /* ignore */
        }
        return (await res.text().catch(() => "")) || `${res.status} ${res.statusText}`;
      };

      const addHist = (url: string): void => {
        hw.classList.add("show");
        const li = document.createElement("li");
        li.className = "history-item";
        const v = document.createElement("video");
        v.src = url;
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.preload = "metadata";
        li.onmouseenter = () => {
          void v.play().catch(() => undefined);
        };
        li.onmouseleave = () => {
          v.pause();
          v.currentTime = 0;
        };
        li.onclick = () => {
          vid.pause();
          vid.src = url;
          vid.load();
          dl.href = url;
          dl.download = `privdark-${Date.now()}.mp4`;
          show("ready");
        };
        li.appendChild(v);
        hl.prepend(li);
      };

      const msgs = [
        "Preparando la imagen...",
        "Esperando GPU en Hugging Face...",
        "Cargando Wan 2.2...",
        "Generando fotogramas...",
        "Montando MP4...",
        "Finalizando...",
      ];

      btn.onclick = async () => {
        const prompt = pr.value.trim();
        if (!file || !prompt || busy) return;
        busy = true;
        sp.classList.add("show");
        bl.textContent = "Generando...";
        ready();
        show("loading");
        status("Enviando imagen y solicitando GPU...");
        let i = 0;
        lm.textContent = msgs[0]!;
        const t = window.setInterval(() => {
          i = Math.min(i + 1, msgs.length - 1);
          lm.textContent = msgs[i]!;
        }, 9000);
        try {
          const fd = new FormData();
          fd.append("image", file, file.name);
          fd.append("params", JSON.stringify({ prompt, steps: Number(st.value) }));
          const res = await fetch(`${W.replace(/\/$/, "")}/generate`, { method: "POST", body: fd });
          if (!res.ok || !res.body) throw new Error(await errMsg(res));
          const url = await readSSE(res.body);
          vid.pause();
          vid.src = url;
          vid.load();
          dl.href = url;
          dl.download = `privdark-${Date.now()}.mp4`;
          show("ready");
          status("Generación completada.", "success");
          addHist(url);
        } catch (e: unknown) {
          const msg = e instanceof Error ? e.message : String(e);
          status(`No se pudo generar: ${msg}`, "error");
          show("empty");
        } finally {
          clearInterval(t);
          busy = false;
          sp.classList.remove("show");
          bl.textContent = "Generar vídeo";
          ready();
        }
      };

      show("empty");
      ready();
    </script>
  </body>
</html>
