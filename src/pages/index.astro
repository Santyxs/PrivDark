---
import "../global.css";
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <title>PrivDark</title>
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={baseUrl} class="brand-lockup">
          <svg viewBox="0 0 40 40" class="brand-mark" aria-hidden="true">
            <defs>
              <linearGradient id="m" x1="4" y1="4" x2="36" y2="36" gradientUnits="userSpaceOnUse">
                <stop stop-color="#e7c5ff" /><stop offset="0.52" stop-color="#a76bff" /><stop offset="1" stop-color="#ed70d7" />
              </linearGradient>
            </defs>
            <path d="M20 3.5 34 11.5v17L20 36.5 6 28.5v-17L20 3.5Z" fill="none" stroke="url(#m)" stroke-width="1.7" />
            <path d="M24.8 10.7a10.1 10.1 0 1 0 4.5 18.6A11.2 11.2 0 0 1 24.8 10.7Z" fill="url(#m)" />
            <circle cx="25.9" cy="19.5" r="1.35" fill="#100b18" />
          </svg>
          <span class="brand-wordmark">PRIV<span>DARK</span></span>
        </a>
      </div>
    </header>

    <main class="wrap studio">
      <div class="studio-shell">
        <div class="studio-card stack">
          <div class="section-heading">
            <div class="section-number">01</div>
            <div><h2>Imagen</h2><p>PNG, JPG o WEBP · máx. 8 MB</p></div>
          </div>

          <label class="dropzone" data-dropzone>
            <input type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" data-file-input />
            <div class="dropzone-empty" data-dropzone-empty>
              <p class="title">Arrastra o pega una imagen</p>
              <p class="browse">o elige un archivo</p>
            </div>
            <img data-dropzone-preview class="preview-img" alt="" />
          </label>

          <div>
            <div class="section-heading compact">
              <div class="section-number">02</div>
              <div><h2>Prompt</h2><p>Máx. 300 caracteres</p></div>
            </div>
            <textarea rows="2" data-prompt class="prompt-field" placeholder="Movimiento breve..."></textarea>
            <div class="prompt-meta"><span></span><span data-prompt-count>0 / 300</span></div>
          </div>

          <div class="params">
            <div class="param">
              <div class="param-label">
                <span>Duración</span>
                <span class="param-value"><span data-duration-value>5.0</span> s</span>
              </div>
              <input type="range" min="1" max="10" step="0.1" value="5" data-duration class="steps-range" aria-label="Duración" />
            </div>
            <div class="param">
              <div class="param-label">
                <span>Pasos</span>
                <span class="param-value" data-steps-value>3</span>
              </div>
              <input type="range" min="3" max="8" step="1" value="3" data-steps class="steps-range" aria-label="Pasos" />
            </div>
            <p class="help-text">Más duración o pasos = más GPU y más tiempo de espera.</p>
          </div>

          <div class="actions">
            <button data-generate class="btn-primary" disabled>
              <span class="pulse-dot" data-spinner></span>
              <span data-button-label>Generar</span>
            </button>
            <p class="status-msg" data-status>Imagen + prompt para generar.</p>
          </div>
        </div>

        <div class="studio-card">
          <div class="output-head">
            <div class="section-heading">
              <div class="section-number">03</div>
              <div><h2>Vídeo</h2><p>Resultado</p></div>
            </div>
          </div>

          <div class="result-frame">
            <div data-result-empty class="result-empty">
              <p class="title">Sin vídeo aún</p>
            </div>
            <div data-result-loading class="result-loading hide">
              <div class="loading-orbit"><span></span><span></span><span></span></div>
              <p class="msg" data-loading-message>Generando...</p>
            </div>
            <video data-result-video controls playsinline class="result-video hide" preload="metadata"></video>
          </div>

          <div class="output-foot">
            <p data-output-meta>MP4 · 5.0 s</p>
            <a data-download class="btn-ghost" href="#">Descargar MP4</a>
          </div>

          <div data-history-wrap class="history-wrap">
            <div class="history-heading"><span>Sesión</span></div>
            <ul data-history class="history-list"></ul>
          </div>
        </div>
      </div>
    </main>

    <script>
      type Tone = "info" | "error" | "success";
      type ResultState = "empty" | "loading" | "ready";

      const W = import.meta.env.PUBLIC_WORKER_URL as string | undefined;
      if (!W) throw new Error("PUBLIC_WORKER_URL no definida");
      const MAX = 8 << 20;
      const PL = 300;
      const HF = "https://cbensimon-wan2-2-fp8da-aoti-preview2.hf.space";

      const q = <T extends Element>(s: string): T => {
        const el = document.querySelector<T>(s);
        if (!el) throw new Error(`Falta: ${s}`);
        return el;
      };

      const dz = q<HTMLLabelElement>("[data-dropzone]");
      const fi = q<HTMLInputElement>("[data-file-input]");
      const de = q<HTMLElement>("[data-dropzone-empty]");
      const dp = q<HTMLImageElement>("[data-dropzone-preview]");
      const pr = q<HTMLTextAreaElement>("[data-prompt]");
      const pc = q<HTMLElement>("[data-prompt-count]");
      const st = q<HTMLInputElement>("[data-steps]");
      const sv = q<HTMLElement>("[data-steps-value]");
      const dur = q<HTMLInputElement>("[data-duration]");
      const dv = q<HTMLElement>("[data-duration-value]");
      const outMeta = q<HTMLElement>("[data-output-meta]");
      const btn = q<HTMLButtonElement>("[data-generate]");
      const bl = q<HTMLElement>("[data-button-label]");
      const sp = q<HTMLElement>("[data-spinner]");
      const stt = q<HTMLElement>("[data-status]");
      const re = q<HTMLElement>("[data-result-empty]");
      const rl = q<HTMLElement>("[data-result-loading]");
      const lm = q<HTMLElement>("[data-loading-message]");
      const vid = q<HTMLVideoElement>("[data-result-video]");
      const dl = q<HTMLAnchorElement>("[data-download]");
      const hw = q<HTMLElement>("[data-history-wrap]");
      const hl = q<HTMLUListElement>("[data-history]");

      let file: File | null = null;
      let busy = false;
      let prev: string | null = null;

      const status = (m: string, t: Tone = "info"): void => {
        stt.textContent = m;
        stt.className = "status-msg" + (t === "error" ? " error" : t === "success" ? " success" : "");
      };

      const ready = (): void => {
        btn.disabled = !(file && pr.value.trim() && !busy);
      };

      const show = (s: ResultState): void => {
        re.classList.toggle("hide", s !== "empty");
        rl.classList.toggle("hide", s !== "loading");
        vid.classList.toggle("hide", s !== "ready");
        dl.classList.toggle("show", s === "ready");
      };

      const accept = (f: File): void => {
        const ok = /image\/(png|jpeg|webp)/i.test(f.type) || /\.(png|jpe?g|webp)$/i.test(f.name);
        if (!ok) return status("Usa PNG, JPG o WEBP.", "error");
        if (!f.size || f.size > MAX) return status(f.size ? "Máx. 8 MB." : "Archivo vacío.", "error");
        file = f;
        if (prev) URL.revokeObjectURL(prev);
        prev = URL.createObjectURL(f);
        dp.src = prev;
        dp.classList.add("show");
        de.classList.add("hide");
        ready();
        status("Listo para generar.", "success");
      };

      fi.onchange = () => {
        const f = fi.files?.[0];
        if (f) accept(f);
      };
      (["dragenter", "dragover"] as const).forEach((e) =>
        dz.addEventListener(e, (ev) => {
          ev.preventDefault();
          dz.dataset.active = "true";
        }),
      );
      (["dragleave", "drop"] as const).forEach((e) =>
        dz.addEventListener(e, () => {
          dz.dataset.active = "false";
        }),
      );
      dz.ondrop = (e) => {
        e.preventDefault();
        const f = e.dataTransfer?.files?.[0];
        if (f) accept(f);
      };
      window.addEventListener("paste", (e: ClipboardEvent) => {
        const f = e.clipboardData?.files?.[0];
        if (f) accept(f);
      });
      pr.maxLength = PL;
      pr.oninput = () => {
        pc.textContent = `${pr.value.length} / ${PL}`;
        ready();
      };
      st.oninput = () => {
        sv.textContent = st.value;
      };
      const fmtDur = (v: string | number): string => Number(v).toFixed(1);
      dur.oninput = () => {
        const d = fmtDur(dur.value);
        dv.textContent = d;
        outMeta.textContent = `MP4 · ${d} s`;
      };

      const videoUrl = (d: unknown): string | null => {
        if (typeof d === "string")
          return /^https?:/i.test(d) ? d : new URL(`/gradio_api/file=${d.replace(/^\//, "")}`, HF).href;
        if (!d || typeof d !== "object") return null;
        const rec = d as { url?: unknown; path?: unknown };
        const c = typeof rec.url === "string" ? rec.url : rec.path;
        if (typeof c !== "string" || !c) return null;
        return /^https?:/i.test(c) ? c : new URL(`/gradio_api/file=${c.replace(/^\//, "")}`, HF).href;
      };

      const parseEvt = (raw: string): string | null => {
        let ev = "message";
        const lines: string[] = [];
        for (const l of raw.split(/\r?\n/)) {
          if (l.startsWith("event:")) ev = l.slice(6).trim();
          else if (l.startsWith("data:")) lines.push(l.slice(5).trimStart());
        }
        if (!lines.length) return null;
        const data = lines.join("\n");
        if (ev === "error") {
          try {
            const p: unknown = JSON.parse(data);
            const msg =
              typeof p === "string"
                ? p
                : p && typeof p === "object" && "message" in p && typeof (p as { message: unknown }).message === "string"
                  ? (p as { message: string }).message
                  : data;
            throw new Error(msg);
          } catch (e) {
            if (e instanceof Error && e.message !== data) throw e;
            throw new Error(data || "Error de Hugging Face");
          }
        }
        if (ev !== "complete") return null;
        const p: unknown = JSON.parse(data);
        const u = videoUrl(Array.isArray(p) ? p[0] : null);
        if (!u) throw new Error("No se recibió el vídeo");
        return u;
      };

      const readSSE = async (body: ReadableStream<Uint8Array>): Promise<string> => {
        const r = body.getReader();
        const d = new TextDecoder();
        let buf = "";
        try {
          while (true) {
            const { value, done } = await r.read();
            if (done) break;
            buf += d.decode(value, { stream: true });
            const parts = buf.split(/\r?\n\r?\n/);
            buf = parts.pop() || "";
            for (const c of parts) {
              const u = parseEvt(c);
              if (u) return u;
            }
          }
          buf += d.decode();
          if (buf.trim()) {
            const u = parseEvt(buf);
            if (u) return u;
          }
        } finally {
          await r.cancel().catch(() => undefined);
          r.releaseLock();
        }
        throw new Error("Conexión cerrada sin vídeo");
      };

      const errMsg = async (res: Response): Promise<string> => {
        try {
          const j: unknown = await res.clone().json();
          if (j && typeof j === "object" && "error" in j && typeof (j as { error: unknown }).error === "string")
            return (j as { error: string }).error;
        } catch {
          /* ignore */
        }
        return (await res.text().catch(() => "")) || `${res.status} ${res.statusText}`;
      };

      const setDownload = (url: string): void => {
        dl.onclick = async (e) => {
          e.preventDefault();
          try {
            const res = await fetch(url);
            if (!res.ok) throw new Error("fail");
            const blob = await res.blob();
            const obj = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = obj;
            a.download = `privdark-${Date.now()}.mp4`;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(obj);
          } catch {
            window.open(url, "_blank", "noopener,noreferrer");
          }
        };
        dl.href = url;
      };

      const addHist = (url: string): void => {
        hw.classList.add("show");
        const li = document.createElement("li");
        li.className = "history-item";
        const v = document.createElement("video");
        v.src = url;
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.preload = "metadata";
        li.onmouseenter = () => {
          void v.play().catch(() => undefined);
        };
        li.onmouseleave = () => {
          v.pause();
          v.currentTime = 0;
        };
        li.onclick = () => {
          vid.pause();
          vid.src = url;
          vid.load();
          setDownload(url);
          show("ready");
        };
        li.appendChild(v);
        hl.prepend(li);
      };

      const msgs = ["Preparando...", "Esperando GPU...", "Cargando modelo...", "Generando frames...", "Montando MP4...", "Casi listo..."];

      btn.onclick = async () => {
        const prompt = pr.value.trim();
        if (!file || !prompt || busy) return;
        busy = true;
        sp.classList.add("show");
        bl.textContent = "Generando...";
        ready();
        show("loading");
        status("Enviando...");
        let i = 0;
        lm.textContent = msgs[0]!;
        const t = window.setInterval(() => {
          i = Math.min(i + 1, msgs.length - 1);
          lm.textContent = msgs[i]!;
        }, 9000);
        try {
          const fd = new FormData();
          fd.append("image", file, file.name);
          fd.append(
            "params",
            JSON.stringify({ prompt, steps: Number(st.value), duration: Number(dur.value) }),
          );
          const res = await fetch(`${W.replace(/\/$/, "")}/generate`, { method: "POST", body: fd });
          if (!res.ok || !res.body) throw new Error(await errMsg(res));
          const url = await readSSE(res.body);
          vid.pause();
          vid.src = url;
          vid.load();
          setDownload(url);
          show("ready");
          status("Listo.", "success");
          addHist(url);
        } catch (e: unknown) {
          status(e instanceof Error ? e.message : String(e), "error");
          show("empty");
        } finally {
          clearInterval(t);
          busy = false;
          sp.classList.remove("show");
          bl.textContent = "Generar";
          ready();
        }
      };

      show("empty");
      ready();
    </script>
  </body>
</html>
